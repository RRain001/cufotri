{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/parameter_database.schema.json",
  "title": "CTEAS UFOTRI parameter database",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "parameters"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/parameter"}
    }
  },
  "$defs": {
    "parameter_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "lower_inclusive", "upper_inclusive"],
      "properties": {
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "lower_inclusive": {"type": "boolean"},
        "upper_inclusive": {"type": "boolean"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope"],
      "properties": {
        "status": {
          "enum": ["applicable", "conditional", "pending_validation"]
        },
        "scope": {"type": "string", "minLength": 1},
        "conditions": {"type": "object"}
      }
    },
    "table_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "values"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {"type": ["number", "string"]}
        }
      }
    },
    "table_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinates", "value"],
      "properties": {
        "coordinates": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["number", "string"]}
        },
        "value": {"type": "number"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "axes", "interpolation", "extrapolation", "lookup_table"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "axes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/table_axis"}
        },
        "interpolation": {"enum": ["exact", "linear"]},
        "extrapolation": {"const": "reject"},
        "lookup_table": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/table_cell"}
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "category",
        "source",
        "reference",
        "confidence",
        "applicability",
        "transform",
        "bounds"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/parameter_name"},
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "source": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "reference": {"type": "string", "minLength": 1},
        "confidence": {
          "enum": [
            "validated",
            "provisional",
            "internal_default",
            "placeholder_pending_validation"
          ]
        },
        "applicability": {"$ref": "#/$defs/applicability"},
        "transform": {
          "enum": ["IDENTITY", "LOG", "LOG10", "LOGIT"]
        },
        "bounds": {
          "anyOf": [
            {"$ref": "#/$defs/bounds"},
            {"type": "null"}
          ]
        },
        "type": {"enum": ["scalar", "table"]},
        "dimensions": {"type": "array"},
        "axes": {"type": "object"},
        "interpolation": {"enum": ["exact", "linear"]},
        "extrapolation": {"const": "reject"},
        "lookup_table": {"type": "array"}
      },
      "allOf": [
        {
          "if": {
            "required": ["confidence"],
            "properties": {
              "confidence": {"const": "placeholder_pending_validation"}
            }
          },
          "then": {
            "properties": {
              "value": {"type": "null"},
              "bounds": {"type": "null"},
              "applicability": {
                "properties": {
                  "status": {"const": "pending_validation"}
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "table"}}
          },
          "then": {
            "required": ["dimensions", "axes", "interpolation", "extrapolation", "lookup_table"],
            "properties": {
              "value": {"type": "null"},
              "dimensions": {"$ref": "#/$defs/table/properties/dimensions"},
              "axes": {"$ref": "#/$defs/table/properties/axes"},
              "interpolation": {"$ref": "#/$defs/table/properties/interpolation"},
              "extrapolation": {"$ref": "#/$defs/table/properties/extrapolation"},
              "lookup_table": {"$ref": "#/$defs/table/properties/lookup_table"}
            }
          }
        },
        {
          "if": {
            "required": ["confidence"],
            "properties": {
              "confidence": {
                "enum": ["validated", "provisional", "internal_default"]
              },
              "type": {"not": {"const": "table"}}
            }
          },
          "then": {
            "properties": {
              "value": {"type": "number"},
              "bounds": {"$ref": "#/$defs/bounds"}
            }
          }
        }
      ]
    }
  }
}
