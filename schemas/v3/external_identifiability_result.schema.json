{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/v3/external_identifiability_result.schema.json",
  "title": "External parameter-identifiability result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "preregistration_sha256",
    "parameter_result_hash",
    "methods",
    "condition_number",
    "max_parameter_correlation",
    "boundary_hits",
    "status",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "preregistration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameter_result_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "condition_number": {"type": "number", "minimum": 0},
    "max_parameter_correlation": {"type": "number", "minimum": 0, "maximum": 1},
    "boundary_hits": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "status": {
      "enum": ["IDENTIFIABLE", "PARTIALLY_IDENTIFIABLE", "NON_IDENTIFIABLE"]
    },
    "generated_at": {"type": "string", "minLength": 1}
  }
}
