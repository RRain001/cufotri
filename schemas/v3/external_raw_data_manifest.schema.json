{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/v3/external_raw_data_manifest.schema.json",
  "title": "External raw-data manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "dataset_id",
    "dataset_version",
    "evidence_type",
    "source",
    "licence_status",
    "local_use_allowed",
    "redistribution_allowed",
    "exposure_start_utc",
    "exposure_end_utc",
    "expected_time_step_seconds",
    "files",
    "units",
    "calibration_sample_ids",
    "holdout_sample_ids",
    "holdout_inspected_before_preregistration"
  ],
  "properties": {
    "manifest_schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "evidence_type": {
      "enum": [
        "CONTROLLED_EXPERIMENT",
        "MATCHED_FIELD_OBSERVATION",
        "LICENSED_EXTERNAL_HOLDOUT",
        "SYNTHETIC_CONTRACT_TEST",
        "INTERNAL_REFERENCE",
        "ANALYTIC_BENCHMARK",
        "INTEGRATION_SCENARIO",
        "REGRESSION_CASE",
        "ERA5_FORCING",
        "LITERATURE_COMPARISON"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authority", "reference"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "licence_status": {
      "enum": ["VERIFIED", "LOCAL_USE_ONLY", "UNRESOLVED", "SYNTHETIC_TEST"]
    },
    "local_use_allowed": {"type": "boolean"},
    "redistribution_allowed": {"type": "boolean"},
    "exposure_start_utc": {"type": "string", "minLength": 1},
    "exposure_end_utc": {"type": "string", "minLength": 1},
    "expected_time_step_seconds": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "expected_sha256",
          "calculated_sha256",
          "size_bytes",
          "format"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "expected_sha256": {
            "oneOf": [
              {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              {"const": "SOURCE_CHECKSUM_UNAVAILABLE"}
            ]
          },
          "calculated_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {"type": "integer", "minimum": 1},
          "format": {"enum": ["csv", "yaml", "json"]}
        }
      }
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    },
    "calibration_sample_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "holdout_sample_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "holdout_inspected_before_preregistration": {"const": false}
  }
}
