{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/v3/validation_case.schema.json",
  "title": "CTEAS_UFOTRI V3 P7.7A ValidationCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "description",
    "scenario_type",
    "forcing_definition",
    "initial_state",
    "parameter_context",
    "model_outputs",
    "reference_data",
    "expected_metric",
    "acceptance_criteria",
    "provenance"
  ],
  "properties": {
    "case_id": { "$ref": "#/$defs/identifier" },
    "description": { "type": "string", "minLength": 1 },
    "scenario_type": {
      "enum": [
        "SYNTHETIC_BENCHMARK",
        "SOFTWARE_REGRESSION",
        "ANALYTICAL_SEMANTIC",
        "EVALUATED_PHYSICAL_CONSTANT",
        "EMPIRICAL_OBSERVATION"
      ]
    },
    "forcing_definition": {
      "type": "object",
      "required": ["forcing_id"],
      "properties": {
        "forcing_id": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": true
    },
    "execution_definition": {
      "type": "object",
      "additionalProperties": true
    },
    "initial_state": {
      "type": "object",
      "required": ["state_id"],
      "properties": {
        "state_id": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": true
    },
    "parameter_context": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameterSnapshot" }
    },
    "model_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observable" }
    },
    "reference_data": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/referenceData" }
    },
    "expected_metric": { "$ref": "#/$defs/expectedMetric" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_identifier",
        "artifact_sha256",
        "license_or_access_basis",
        "locator"
      ],
      "properties": {
        "source_kind": { "type": "string", "minLength": 1 },
        "source_identifier": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "license_or_access_basis": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "parameterSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "value", "unit", "status", "provenance"],
      "properties": {
        "parameter_id": { "$ref": "#/$defs/identifier" },
        "value": { "type": ["string", "number", "boolean"] },
        "unit": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["TEST_ONLY", "PROVISIONAL", "VALIDATED", "ACTIVE"]
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_id",
        "quantity",
        "unit",
        "time_basis",
        "output_reference"
      ],
      "properties": {
        "observable_id": { "$ref": "#/$defs/identifier" },
        "quantity": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "time_basis": { "type": "string", "minLength": 1 },
        "output_reference": { "type": "string", "minLength": 1 }
      }
    },
    "referenceData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_id",
        "quantity",
        "unit",
        "time_basis",
        "reference_method",
        "independent",
        "provenance"
      ],
      "properties": {
        "observable_id": { "$ref": "#/$defs/identifier" },
        "quantity": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "time_basis": { "type": "string", "minLength": 1 },
        "reference_method": { "type": "string", "minLength": 1 },
        "independent": { "type": "boolean" },
        "reference_expression": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "anyOf": [
        { "required": ["reference_expression"] },
        { "required": ["values"] }
      ]
    },
    "expectedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_name", "observable_id", "unit"],
      "properties": {
        "metric_name": { "type": "string", "minLength": 1 },
        "observable_id": { "$ref": "#/$defs/identifier" },
        "unit": { "type": "string", "minLength": 1 },
        "reference_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_name",
        "observable_id",
        "threshold",
        "comparison",
        "unit",
        "rationale"
      ],
      "properties": {
        "metric_name": { "type": "string", "minLength": 1 },
        "observable_id": { "$ref": "#/$defs/identifier" },
        "threshold": { "type": "number", "minimum": 0 },
        "comparison": { "enum": ["ABSOLUTE_LTE", "LTE", "GTE", "EXACT"] },
        "unit": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
