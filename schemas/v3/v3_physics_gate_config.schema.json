{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/v3/v3_physics_gate_config.schema.json",
  "title": "V3 physics-gate evidence entry configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_bundle_path",
    "allowed_artifact_roots",
    "allowed_raw_data_roots",
    "required_regression_reports"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "evidence_bundle_path": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "allowed_artifact_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_raw_data_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_regression_reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v1", "v2", "validation_readiness"],
      "properties": {
        "v1": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "v2": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "validation_readiness": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        }
      }
    }
  }
}
