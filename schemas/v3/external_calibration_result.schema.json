{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/v3/external_calibration_result.schema.json",
  "title": "External calibration result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "raw_manifest_sha256",
    "intake_manifest_sha256",
    "preregistration_sha256",
    "preregistration_commit",
    "calibration_ids",
    "parameter_contract_hash",
    "parameter_result_hash",
    "config_hash",
    "model_commit",
    "parameters",
    "metrics",
    "status",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "raw_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "intake_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preregistration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preregistration_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "calibration_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "parameter_contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parameter_result_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "transform"],
          "properties": {
            "value": {"type": "number"},
            "unit": {"type": "string", "minLength": 1},
            "transform": {"enum": ["IDENTITY", "LOG", "LOG10", "LOGIT"]}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    },
    "status": {"const": "CALIBRATION_COMPLETE"},
    "generated_at": {"type": "string", "minLength": 1}
  }
}
