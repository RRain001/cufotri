{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/v3/forcing_manifest.schema.json",
  "title": "V3 forcing manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset",
    "product",
    "licence",
    "time_zone",
    "start",
    "end",
    "interval_seconds",
    "latitude_deg",
    "longitude_deg",
    "variables",
    "files",
    "gap_policy"
  ],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "dataset": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "licence": {"type": "string", "minLength": 1},
    "time_zone": {"const": "UTC"},
    "start": {"type": "string", "format": "date-time"},
    "end": {"type": "string", "format": "date-time"},
    "interval_seconds": {"type": "integer", "minimum": 1},
    "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "status", "accumulation_semantics"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["observed", "reanalysis", "interpolated", "extended"]
          },
          "accumulation_semantics": {
            "enum": ["instantaneous", "interval_ending_at_valid_time"]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_path", "sha256", "tracked"],
        "properties": {
          "local_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "tracked": {"const": false}
        }
      }
    },
    "gap_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maximum_gap_hours"],
      "properties": {
        "mode": {"enum": ["fail", "interpolate", "extend"]},
        "maximum_gap_hours": {"type": "number", "minimum": 0}
      }
    }
  }
}
