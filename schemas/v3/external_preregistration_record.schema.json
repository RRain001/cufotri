{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/v3/external_preregistration_record.schema.json",
  "title": "External preregistration record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "raw_manifest_sha256",
    "intake_manifest_sha256",
    "preregistration_file",
    "preregistration_sha256",
    "preregistration_commit",
    "calibration_ids",
    "holdout_ids",
    "primary_metric",
    "thresholds",
    "parameter_set",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "raw_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "intake_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preregistration_file": {"type": "string", "minLength": 1},
    "preregistration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "preregistration_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "calibration_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "holdout_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "primary_metric": {"type": "string", "minLength": 1},
    "thresholds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    },
    "parameter_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "status": {"const": "FROZEN_BEFORE_HOLDOUT_INSPECTION"}
  }
}
