{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cteas-ufotri.local/schemas/v3/external_preregistration_file.schema.json",
  "title": "Frozen external preregistration file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "calibration_ids",
    "holdout_ids",
    "primary_metrics",
    "parameter_set",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "calibration_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "holdout_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "required",
          "comparator",
          "threshold",
          "value_unit",
          "missing_policy",
          "calculation"
        ],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "comparator": {
            "enum": ["LT", "LE", "GT", "GE", "BETWEEN_CLOSED", "ABS_LE"]
          },
          "threshold": {
            "oneOf": [
              {"type": "number"},
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"type": "number"}
              }
            ]
          },
          "value_unit": {"type": "string", "minLength": 1},
          "missing_policy": {"enum": ["FAIL", "INCONCLUSIVE"]},
          "calculation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "observation_role",
              "observation_id_column",
              "observation_value_column",
              "result_file",
              "prediction_id_column",
              "prediction_value_column"
            ],
            "properties": {
              "method": {"const": "NORMALIZED_RMSE"},
              "observation_role": {"type": "string", "minLength": 1},
              "observation_id_column": {"type": "string", "minLength": 1},
              "observation_value_column": {"type": "string", "minLength": 1},
              "result_file": {"type": "string", "minLength": 1},
              "prediction_id_column": {"type": "string", "minLength": 1},
              "prediction_value_column": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "parameter_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "status": {"const": "FROZEN_BEFORE_HOLDOUT_INSPECTION"}
  }
}
