{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cteas-ufotri/environmental-pathway-case.schema.json",
  "title": "CTEAS UFOTRI V2 environmental pathway validation case",
  "type": "object",
  "required": [
    "validation_id",
    "reference_type",
    "release_scenario",
    "model",
    "reference",
    "observables"
  ],
  "properties": {
    "validation_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "reference_type": {
      "enum": [
        "ANALYTIC",
        "MANUAL_ANCHOR",
        "LITERATURE_NUMERIC",
        "EXPERIMENT",
        "FIELD_OBSERVATION",
        "REFERENCE_MODEL",
        "SITE_CASE",
        "INTERNAL_REGRESSION"
      ]
    },
    "release_scenario": {
      "$ref": "release_scenario.schema.json"
    },
    "model": {
      "type": "object",
      "required": ["default_config", "case_config", "overrides"],
      "properties": {
        "default_config": {"type": "string"},
        "case_config": {"type": "string"},
        "overrides": {"type": "object"}
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "name",
        "version",
        "citation",
        "data_file",
        "licence",
        "checksum_sha256"
      ],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "citation": {"type": "string"},
        "data_file": {"type": "string"},
        "licence": {"type": "string"},
        "checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model_column",
          "reference_column",
          "unit",
          "metric",
          "threshold"
        ],
        "properties": {
          "model_column": {"type": "string"},
          "reference_column": {"type": "string"},
          "unit": {"type": "string"},
          "metric": {"type": "string"},
          "threshold": {"type": "number", "minimum": 0},
          "detection_limit": {"type": ["number", "null"], "minimum": 0},
          "unit_conversion": {"type": "string"}
        }
      }
    },
    "dataset_contract": {
      "type": "object",
      "description": "Optional tabular environmental dataset contract. Each supplied quantity declares its source column and unit; conversion to the canonical unit is explicit.",
      "required": ["time_column", "time_zone", "quantities"],
      "properties": {
        "time_column": {"type": "string"},
        "time_zone": {"const": "UTC"},
        "forcing_status_column": {"type": ["string", "null"]},
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "quantity",
              "column",
              "source_unit",
              "canonical_unit",
              "unit_conversion"
            ],
            "properties": {
              "quantity": {
                "enum": [
                  "time",
                  "air_hto",
                  "precipitation",
                  "wind_speed",
                  "temperature",
                  "relative_humidity",
                  "soil_water",
                  "soil_hto",
                  "plant_tfwt",
                  "plant_obt",
                  "food_concentration",
                  "milk_concentration",
                  "beef_concentration",
                  "dose",
                  "uncertainty"
                ]
              },
              "column": {"type": "string"},
              "source_unit": {"type": "string"},
              "canonical_unit": {"type": "string"},
              "unit_conversion": {"type": "string"},
              "detection_limit_column": {"type": ["string", "null"]},
              "uncertainty_column": {"type": ["string", "null"]},
              "missing_value": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "missing_value_policy": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
